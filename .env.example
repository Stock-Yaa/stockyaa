# Copy to .env.local and fill in. With DATABASE_URL unset the app uses an
# embedded local database with demo data, and needs none of these.

# Supabase Postgres connection string (Project settings > Database > URI).
DATABASE_URL=

# Connections this app instance may open (default 5). Use 1 on serverless hosts.
DATABASE_POOL_MAX=

# Secret used to sign session cookies. Required in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Currency and time zone of the super admin's revenue figures (defaults THB, Asia/Bangkok).
# Payments in other currencies are listed but left out of the totals.
PLATFORM_CURRENCY=
PLATFORM_TIMEZONE=

# Stripe (card billing is not wired up yet; the super admin Stripe page shows whether these are set).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# First super admin, created by `npm run db:seed` in an empty database.
SUPERADMIN_NAME=Platform Admin
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# Set to true to also create the demo pharmacy when seeding.
SEED_DEMO=false

# Supabase Storage for private files (receipt photos of cash drawer pay-outs). Project URL
# (https://<ref>.supabase.co) and the service role / secret key from Project settings > API keys.
# The bucket is created on first upload. Without these, development keeps files in ./.uploads
# and production refuses pay-outs, since they need a receipt photo.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional bucket name (default stockyaa-private).
SUPABASE_STORAGE_BUCKET=

# Secret used to encrypt stored API keys (e.g. each pharmacy's OpenAI key). Required in
# production to save keys; changing it makes saved keys unreadable, so they must be entered again.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_SECRET=
